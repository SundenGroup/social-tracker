# Database
DATABASE_URL="postgresql://user:password@localhost:5432/clutch_social_tracker"

# NextAuth
NEXTAUTH_SECRET="generate-a-secret-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Separate encryption key for API credentials (optional — falls back to NEXTAUTH_SECRET)
# ENCRYPTION_KEY="generate-a-separate-secret-with-openssl-rand-base64-32"

# YouTube Data API v3
YOUTUBE_API_KEY=""

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""

# Scraping Configuration (Twitter, TikTok)
PLAYWRIGHT_HEADLESS="true"
SCRAPE_DELAY_MS="3000"
SCRAPE_MAX_RETRIES="3"

# Email delivery — pick one provider. Resend is preferred because its HTTPS
# API works on hosts that block outbound SMTP (e.g. DigitalOcean droplets).
# If neither is set, emails are skipped and the admin UI falls back to
# showing the raw invitation / reset URL so admins can relay it manually.

# Resend (recommended). Get an API key at https://resend.com and verify
# your sending domain so EMAIL_FROM can use an @yourdomain.com address.
RESEND_API_KEY=""
EMAIL_FROM="Clutch Social <noreply@clutch.game>"

# Legacy SMTP — used automatically when RESEND_API_KEY is empty. Any
# standard SMTP provider works (SendGrid, SES, Mailgun, Postmark, Gmail…).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Public registration. Default: closed (invite-only). Flip to "true" only if
# you actually want self-service signup (dev/staging). On the first-ever
# deploy the very first user is always allowed through, regardless of this
# flag, so the bootstrap admin account can be created.
ALLOW_PUBLIC_REGISTRATION="false"

# Cron Security (for automated sync trigger)
CRON_SECRET_TOKEN="generate-a-random-token"
