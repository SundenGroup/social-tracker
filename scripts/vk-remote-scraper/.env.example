# VK remote scraper
# Copy this to .env and fill in before running `npm run scrape`.

# Clutch Social ingest endpoint + shared secret (same CRON_SECRET_TOKEN
# the server uses — see /api/sync/ingest).
INGEST_URL="https://social.clutch.game/api/sync/ingest"
API_TOKEN=""

# Comma-separated list of VK group short names (what comes after vk.com/).
# Each must correspond to a SocialAccount in the dashboard with
# platform=vk, accountId=<short_name>.
VK_ACCOUNTS="pubg"

# How many wall posts to attempt per run. VK shows ~10-20 to logged-out
# visitors anyway; scrolling further rarely helps.
MAX_POSTS_PER_RUN="100"

# Run headless by default. Flip to "false" when debugging locally.
HEADLESS="true"
