<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.clutch.browser-server-instagram</string>

    <key>WorkingDirectory</key>
    <string>__REPO__/scripts/instagram-remote-scraper</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>exec npx tsx browser-server.ts</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>StandardOutPath</key>
    <string>__REPO__/scripts/scraper-host/logs/browser-server-instagram.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/scripts/scraper-host/logs/browser-server-instagram.log</string>

    <key>ThrottleInterval</key>
    <integer>30</integer>
</dict>
</plist>
