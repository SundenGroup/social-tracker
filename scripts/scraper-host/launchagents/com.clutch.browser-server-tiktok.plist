<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.clutch.browser-server-tiktok</string>

    <key>WorkingDirectory</key>
    <string>__REPO__/scripts/tiktok-remote-scraper</string>

    <!-- bash -lc so PATH resolves node/npx regardless of how Node was
         installed (brew /usr/local on Intel, /opt/homebrew on ARM, nvm) -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>exec npx tsx browser-server.ts</string>
    </array>

    <!-- Start at login, restart if Chrome or the wrapper dies. This is
         what makes the logged-in browser survive reboots unattended. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- GUI session only — Chrome needs a window server -->
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>StandardOutPath</key>
    <string>__REPO__/scripts/scraper-host/logs/browser-server-tiktok.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/scripts/scraper-host/logs/browser-server-tiktok.log</string>

    <!-- Don't restart-loop faster than every 30s if something is broken -->
    <key>ThrottleInterval</key>
    <integer>30</integer>
</dict>
</plist>
