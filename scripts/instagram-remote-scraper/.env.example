# Clutch Social Tracker — Instagram Remote Scraper
# Copy this to .env and fill in values

# Production API URL
API_URL=https://social.clutch.game

# Same token as CRON_SECRET_TOKEN on the server
API_TOKEN=your-api-token-here

# Instagram accounts to scrape (comma-separated, without @)
# These must match the accountId in the database
INSTAGRAM_USERNAMES=pubgesports,pubgesportsbra,pubg_battlegrounds_tur

# Max posts to scrape per account per run
MAX_POSTS=50

# Retry settings (for scheduled/unattended runs)
MAX_RETRIES=3
RETRY_DELAY_MIN=5

# --- Pause / resume (optional) ---
# The scraper writes a checkpoint-<username>.json every N posts so that
# Ctrl+C or a crash doesn't lose progress. Next run with the same username
# resumes right where it left off (skipping the scroll phase too). Leave
# CHECKPOINT_EVERY at the default unless you're tuning.
CHECKPOINT_EVERY=25

# If > 0, incrementally push completed batches to the server every N posts
# in addition to the normal final push. Useful for long runs so data shows
# up in the dashboard before the scrape finishes (and also bounds how much
# data is lost if the machine is yanked). 0 = only push at the end.
PUSH_EVERY=0
