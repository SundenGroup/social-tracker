# Clutch Social Tracker — Instagram Remote Scraper
# Copy this to .env and fill in values

# Production API URL
API_URL=https://social.clutch.game

# Same token as CRON_SECRET_TOKEN on the server
API_TOKEN=your-api-token-here

# Instagram accounts to scrape (comma-separated, without @)
# These must match the accountId in the database
INSTAGRAM_USERNAMES=pubgesports,pubgesportsbra,pubg_battlegrounds_tur

# Max posts to scrape per account per run
MAX_POSTS=50

# Retry settings (for scheduled/unattended runs)
MAX_RETRIES=3
RETRY_DELAY_MIN=5
